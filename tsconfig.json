{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "resolveJsonModule": true, "jsx": "react-jsx",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "verbatimModuleSyntax": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "vite.config.ts"]
}
